        <profile name="Grim Efficiency" id="04b8-4a7a-38d4-7d2e" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">During the movement phase, before the Kahl moves, he may select one enemy within 24&quot; and line of sight to gain a Judgement Token.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="High Kahl" id="eefe-54f8-d765-c609" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="847c-1d69-ba29-0aa6" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="50"/>
          </costs>
          <profiles>
            <profile name="Efficient Exemplar" id="af72-23d3-643f-4eab" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If a High Kahl (or his unit) destroys a unit with Judgement Tokens, one token may be transferred to a different enemy unit visible to and within 24&quot; of the High Kahl.</characteristic>
              </characteristics>
            </profile>
            <profile name="Kahl wills it!" id="b3ff-078b-e598-573b" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="e24a-6018-20cf-d76c">During the shooting phase, one friendly Votann unit within 6&quot; of the High Kahl may count their weapons as twin-linked.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
