    <profile name="Titan Close-combat Weapon" id="bce6-a45a-2a27-ff77" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
      <characteristics>
        <characteristic name="Ability" typeId="2113-98a2-4376-a94c">Each Titan Close Combat Weapon adds three extra close combat attacks to the profile of the unit. It also confers the destroyer rule to all the walker&apos;s close combat attacks. Note that the Stomp special rule is not affected by either of these bonuses. The enemy may apply a weapon destroyed result against a Titan close-combat weapon, which counts as a Primary Weapon. If the weapon is destroyed - the walker loses the three extra attacks and the destroyer rule in close combat.</characteristic>
      </characteristics>
    </profile>
    <profile name="Bomb" id="573a-0df7-343d-c3ff" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">Bomb</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">6</characteristic>
        <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">4</characteristic>
        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Apocalypse Barrage (1), One-Shot</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c">You may elect to drop as many bombs as you wish in a single bombing run - for each bomb dropped, roll once on the Apocalyptic Barrage template.</characteristic>
      </characteristics>
    </profile>
    <profile name="Hellstorm Bomb" id="e9b9-5ba0-b2d7-ebd9" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">Hellstorm</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">7</characteristic>
        <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">3</characteristic>
        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Inferno!, One-shot, Ignore Cover</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c">You may only drop one Hellstorm per bombing run.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedRules>
    <rule name="Inferno!" id="eb48-a5c5-68bd-6de3" hidden="false">
      <description>Execute a Bombing run and then place the Hellstorm template anywhere along the bombing corridor, with the large end towards the flyer. The template is then moved 3D6 forward along the bombing corridor towards the flyer (Hits are only scored after the template has moved). Once the template is in place, hits are determined as described in the weapons datasheet (No cover saves apply) </description>
    </rule>
  </sharedRules>
