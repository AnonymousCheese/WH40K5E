        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c">Rolle 3D6+10 for armour penetration against targets under the hole in the centre of the marker, and 2D6+10 against other targets.</characteristic>
      </characteristics>
    </profile>
    <profile name="Plasma Destructor (Full)" id="071b-f4ee-4434-ee57" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
