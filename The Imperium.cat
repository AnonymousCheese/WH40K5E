    <profile name="Vortex Support Missile" id="153d-8f69-ba76-c6b3" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">48-480&quot;</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">n/a</characteristic>
        <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">n/a</characteristic>
        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Ordnance 1, Apocalyptic Blast, One-shot, Primary Weapon</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c">After determining the final position of the marker, any models and removable terrain features touched by the blast are removed from the game (flyers are not affected). Gargantuan Creatures are not removed, but automatically lose D6 Wounds. Super-heavy vehicles are not removed, but automatically lose D3 Structure Points.


NO SAVE OF ANY KIND (EVEN INVULNERABLES) ARE ALLOWED!</characteristic>
      </characteristics>
    </profile>
    <profile name="Vulcan Mega-bolter" id="16a9-3946-9ebd-ffb9" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
