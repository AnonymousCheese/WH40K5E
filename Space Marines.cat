        <profile name="Land Speeder Storm" id="cfdd-885e-f2b9-a1eb" hidden="false" typeId="9a37-e4d2-11fe-9e81" typeName="Transport">
          <characteristics>
            <characteristic name="Capacity" typeId="7cdf-4c80-a83d-200c">5 models (Scouts only)</characteristic>
            <characteristic name="Access Points" typeId="6e42-3bd5-70a6-724f"/>
