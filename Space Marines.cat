              </constraints>
              <profiles>
                <profile name="Force Dome" id="de6b-13b4-d0bd-8f5e" hidden="false" typeId="8c68-ad11-33db-e3c4" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Power" typeId="1638-2569-4ea3-9b0a">This power is used at the start of the Librarian&apos;s Movement phase. The Librarian and any unit he is with receive a 5+ invulnerable save until the end of the following player turn.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Machine Curse" id="8618-5f1c-2b1b-6c4a" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="c509-c03d-df6d-db1a" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Machine Curse" id="e754-11cd-459b-8942" hidden="false" typeId="8c68-ad11-33db-e3c4" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Power" typeId="1638-2569-4ea3-9b0a">This power is a psychic shooting attack with a range of 24&quot; that only affects vehicles. If the Machine Curse hits, the target vehicle automatically suffers a glancing hit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="The Avenger" id="a900-92b0-3e79-5d99" hidden="false" import="true" type="upgrade">
              <constraints>
