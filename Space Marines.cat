      <profiles>
        <profile name="Kor&apos;sarro Khan" id="a49b-f02e-6873-1a09" hidden="false" typeId="0967-823d-dd82-4e47" typeName="Unit">
          <characteristics>
            <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">6</characteristic>
            <characteristic name="BS" typeId="63a5-4be2-9cc0-7723">5</characteristic>
            <characteristic name="S" typeId="09af-e927-0c3c-9d88">4</characteristic>
            <characteristic name="T" typeId="ff29-f8b2-5b20-b686">4</characteristic>
            <characteristic name="W" typeId="4a81-ac45-a71c-c71e">3</characteristic>
            <characteristic name="I" typeId="8517-a46c-d6df-9c75">5</characteristic>
            <characteristic name="A" typeId="a535-0722-3bc1-4d3c">3</characteristic>
            <characteristic name="Ld" typeId="ddd5-77eb-4cc8-9eab">10</characteristic>
            <characteristic name="Sv" typeId="c1e7-f1bd-8acd-7595">3+</characteristic>
          </characteristics>
        </profile>
        <profile name="Mounted Assault" id="ef80-9777-9774-78a5" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If Kor&apos;sarro Khan rides Moondrakken, Space Marine Bike Squads of at least five models may be taken as Troop choices.</characteristic>
          </characteristics>
        </profile>
        <profile name="Master of the Hunt" id="123d-596d-c8c8-58b7" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Kor&apos;sarro Khan, and models in his unit benefit from the hit and run and furious charge special rules.</characteristic>
          </characteristics>
        </profile>
        <profile name="Chapter Tactics" id="31ae-3fe9-4b4c-048a" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If you include Kor&apos;sarro Khan then all units in your army exchange the Combat Tactics special rule for the ability to outflank. If you choose to do this, all dedicated transports also gain the ability to outflank - see the Reserves mission special rule. If more than one character in your army has the Chapter Tactics special rule, you must choose which will apply.</characteristic>
          </characteristics>
        </profile>
        <profile name="Moonfang" id="9451-208b-c7b9-67e8" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
          <characteristics>
            <characteristic name="Ability" typeId="2113-98a2-4376-a94c">This counts as a Power weapon. Any rolls to wound on which Kor&apos;sarro scores a 6 will cause Instant Death, regardless of the target&apos;s Toughness.</characteristic>
          </characteristics>
        </profile>
      </profiles>
