    <profile name="Artificer Armour" id="ade4-a747-5dea-4201" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
      <characteristics>
        <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">The model gains a 2+ armour save.</characteristic>
      </characteristics>
