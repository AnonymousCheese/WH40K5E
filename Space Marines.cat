          <selectionEntries>
            <selectionEntry name="Company Standard" id="38a7-4d7a-8149-cf81" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="2121-feea-957a-1764" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15"/>
              </costs>
              <profiles>
                <profile name="Company Standard" id="8d21-7000-5862-24b8" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">Any Space Marine unit within 12&quot; of the Standard Bearer always re-rolls failed Morale and Pinning Tests. In addition, while the standard bearer is still alive, the Command squad counts as scoring one extra wound in close combat for the purposes of calculating assault results.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
