        <profile name="God of War" id="34da-d65b-cb07-7874" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Calgar can choose whether to pass or fail any Morale check he is called upon to make. Whilst Calgar is on the table, all units with the Combat Tactics special rule can also choose whether to pass or fail any Morale check they are called upon to take.</characteristic>
