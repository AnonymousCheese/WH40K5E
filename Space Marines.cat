                    <characteristic name="Sv" typeId="c1e7-f1bd-8acd-7595">2+</characteristic>
                  </characteristics>
                </profile>
                <profile name="Chapter Banner" id="4fc1-8f3a-5aa0-f31f" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">Any Space Marine unit within 12&quot; of the Banner Bearer always re-rolls failed Morale and Pinning tests. In addition, all models in the same unit as the Chapter Banner have +1 Attack whilst the banner bearer is alive. While the Banner Bearer is alive, the Honour Guard counts as scoring one extra wound in close combat for the purposes of calculating the assault result.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
