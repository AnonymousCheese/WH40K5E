        <profile name="Chapter Tactics" id="d132-51a8-336b-debe" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If you include Pedro Kantor then all units in your army exchange the Combat Tactics special rule for the Stubborn universal special rule and your Sternguard Veteran squads gain the Hold The Line! special rule. If more than one character in your army has the Chapter Tactics special rule, you must choose which version will apply.</characteristic>
          </characteristics>
        </profile>
        <profile name="Hold the Line!" id="0fd1-fe0c-7dac-558d" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If your army includes Pedro Kantor, your Sternguard Veteran squads are scoring units.</characteristic>
          </characteristics>
        </profile>
        <profile name="Inspiring Presence" id="fdea-459f-d220-cc9c" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">All friendly units within 12&quot; of Pedro Kantor receive +1 Attack whilst he lives. This bonus does not apply to Kantor, and does not stack with the similar bonus from a Chapter Banner.</characteristic>
          </characteristics>
        </profile>
        <profile name="Dorn&apos;s Arrow" id="c526-53a4-6363-1aef" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
          <characteristics>
