        <profile name="Bolter Drill" id="f45d-bca9-ca8c-6f7d" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Any models in a squad Lysander has joined can re-roll failed &apos;to hit&apos; rolls when shooting with Heavy Bolters, Storm Bolters, Bolters and Bolt Pistols.</characteristic>
          </characteristics>
        </profile>
        <profile name="Chapter Tactics" id="8bd6-6d9d-afbe-47c9" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If you include Lysander then all units in your army exchange the combat tactics special rule for the Stubborn universal rule. If more than one character in your army has the Chapter Tactics special rule, you must choose which version will apply.</characteristic>
          </characteristics>
        </profile>
        <profile name="Fist of Dorn" id="424e-23c0-5d32-b9b3" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
          <characteristics>
            <characteristic name="Ability" typeId="2113-98a2-4376-a94c">This is a master-crafted Thunder Hammer. All hits from the Fist of Dorn are resolved at Strength 10 and add +1 to rolls on the vehicle damage table.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
