        <modifier affects="self.entries.forces.recursive.5ade-c79d-6b76-2ca1" field="hidden" scope="f9e0-9be9-a007-5d68" type="set" value="true"/>
      </modifiers>
      <profiles>
        <profile name="The Lord Hellion" id="81d8-2fbb-2eae-dcfa" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Hellions are Troops choices in any army that includes Baron Sathonyx.</characteristic>
          </characteristics>
        </profile>
        <profile name="Custom Skyboard" id="2bb0-168a-c6e2-d800" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">Sathonyx&apos;s custom Skyboard counts as a normal Skyboard. In addition, it adds +2 Strength to his attacks in any turn in which he assaults.</characteristic>
          </characteristics>
        </profile>
        <profile name="Bones of the Seer" id="b665-a603-c607-ea67" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">An army that includes Sathonyx adds one to the dice roll when determining which side chooses deployment zone.</characteristic>
          </characteristics>
        </profile>
        <profile name="Twilight Shroud" id="0064-2734-859c-d0f3" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">The Twilight Shroud confers the Stealth rule to Sathonyx and his unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Master of the Skies" id="629e-ff93-d6a2-d346" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Sathonyx and any unit of Hellions he joins may re-roll failed Dangerous terrain tests. Also, when using their Hit and Run rule, they can re-roll both the Initiative test and the dice to determine how far they move.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
