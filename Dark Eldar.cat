    </profile>
    <profile name="Obsidian Orbs" id="0585-bdaa-52c1-80fc" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">12&quot;</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">10*</characteristic>
        <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">3</characteristic>
        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Assault 1, Blast</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c">Roll against the enemy&apos;s Leadership instead of their Toughness. Models without a Leadership value are unaffected. Each wound caused by an Obsidian Orb will heal a wound Vect has suffered earlier in the battle.</characteristic>
      </characteristics>
    </profile>
    <profile name="Orb of Despair" id="f39b-a2ff-926e-d07f" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
