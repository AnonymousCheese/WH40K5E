        <infoLink name="Stealth" id="f279-e4ad-8819-24d1" hidden="false" targetId="8dc7-2ec3-1248-9d84" type="profile"/>
      </infoLinks>
      <profiles>
        <profile name="Decapitator" id="2395-743b-5253-9413" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
          <characteristics>
            <characteristic name="Ability" typeId="2113-98a2-4376-a94c">This is a power weapon that on a roll of 6 to wound causes instant death, regardless of the enemy&apos;s Toughness.</characteristic>
          </characteristics>
        </profile>
        <profile name="Shade Stalker" id="9899-28e3-95be-3a81" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">When Kheradruakh arrives from reserve, simply place him anywhere on the battlefield that is not within an inch of an enemy model. He may not assault that turn, but may otherwise act normally.</characteristic>
          </characteristics>
        </profile>
        <profile name="Hunter of Heads" id="ea0e-5c46-ba97-ca30" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Nominate an enemy Independent Character at the beginning of the game as the unfortunate whose skull the Decapitator intends to take. Kheradruakh has the Preferred Enemy rule for attacks made against this model.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Baron Sathonyx" id="9619-8374-9fae-3d2a" hidden="false" import="true" type="unit">
      <costs>
