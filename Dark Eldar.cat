    <profile name="Sky Assassin" id="e474-9c2d-a551-b773" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">When entering play via Deep Strike, if it does so within 12&quot; of an enemy Skimmer or Flyer, its player may re-roll the Scatter dice to determine where it arrives</characteristic>
      </characteristics>
    </profile>
    <profile name="Twin-linked Dark Lance" id="bb2c-cf2a-d21a-a413" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
