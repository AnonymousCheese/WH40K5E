    <profile name="Void Mine" id="f77e-2871-8357-3e75" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">*</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">9</characteristic>
        <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">2</characteristic>
        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Assault 1, Blast, One Shot, Lance</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c">During the Voidraven Bomber&apos;s Movement phase, it may place a small blast marker centred upon any one model it has passed over that turn and roll a scatter dice. If an arrow is rolled move the template D6&quot; in that direction. Once the final position of the template has been determined, resolve the effects above. Note that this counts as using a weapon.</characteristic>
      </characteristics>
    </profile>
    <profile name="Casket of Flensing" id="a3d5-b6be-8785-b76a" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
