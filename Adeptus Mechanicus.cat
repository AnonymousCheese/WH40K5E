    <profile name="Hydraulic Claw" id="96a9-755d-6ca2-73d9" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
      <characteristics>
        <characteristic name="Ability" typeId="2113-98a2-4376-a94c">This is a close combat weapon which fights at Initiative 1. Alternatively, the bearer may make a single attack which counts as being made by a Power Fist.</characteristic>
