        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Assault 4 or Heavy 6</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c">The roll needed To Wound for this weapon is equal to the Armour save of the target, to a minimum of 6+. When resolving a hit against a vehicle, roll a D6 for each hit instead of rolling for armour penetration as normal. On a 1-5 nothing happens, but on a 6, the target suffers an Immobilised result.</characteristic>
      </characteristics>
    </profile>
