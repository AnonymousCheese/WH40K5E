    <profile name="Electroleech Stave" id="e1b6-f83c-6501-bdb7" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
      <characteristics>
        <characteristic name="Ability" typeId="2113-98a2-4376-a94c">This is a two-handed close combat weapon which adds +2 to the bearer&apos;s Strength. Additionally, any model which suffers an unsaved wound from this weapon will have its Initiative reduced to 1 until the beginning of your next turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="Electrostatic Gauntlets" id="b855-fe83-8094-cfbf" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
