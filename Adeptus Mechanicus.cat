        <profile name="Shock" id="fee1-702f-4db5-bac5" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Whenever a model with this special rule makes attacks with its electrostatic gauntlets in the Shooting phase or the Assault phase, each To Hit roll of a 6 causes 2 additional hits on the target.</characteristic>
