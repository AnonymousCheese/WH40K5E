    </profile>
    <profile name="Power Axe" id="5b9a-2c40-1511-45fd" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
      <characteristics>
        <characteristic name="Ability" typeId="2113-98a2-4376-a94c">This is a Power fist, however, it only adds +1 Strength to the bearer instead of doubling.</characteristic>
      </characteristics>
