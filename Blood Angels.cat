      <profiles>
        <profile name="Chapter Banner" id="1ee5-1d58-f57d-2703" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">All friendly units within 12&quot; of the standard bearer re-rolls failed Morale and Pinning tests. In addition, all models in the same unit as the Chapter Banner have +1 Attack whilst the banner bearer is alive.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
