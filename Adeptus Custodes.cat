        <characteristic name="W" typeId="4a81-ac45-a71c-c71e">3</characteristic>
        <characteristic name="I" typeId="8517-a46c-d6df-9c75">6</characteristic>
        <characteristic name="A" typeId="a535-0722-3bc1-4d3c">2</characteristic>
        <characteristic name="Ld" typeId="ddd5-77eb-4cc8-9eab">10</characteristic>
        <characteristic name="Sv" typeId="c1e7-f1bd-8acd-7595">2+ (5++)</characteristic>
      </characteristics>
    </profile>
    <profile name="Pyrithite Spear" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons" hidden="false" id="3c0c-ee99-f1c7-2073">
      <characteristics>
        <characteristic name="Ability" typeId="2113-98a2-4376-a94c">A Pyrithite Spear is a power weapon that adds +2 to the wielder&apos;s Strength. 
Any model equipped with a Pyrithite Spear is also equipped with a Meltagun.</characteristic>
      </characteristics>
    </profile>
    <profile name="Castellan&apos;s Mark" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="f329-080c-bd9a-0d8c">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If this model is on the battlefield at the start of the game before the first turn begins, you may select up to two of your Adeptus Custodes units on the battlefield including the bearer and its unit. You may then set them up on the battlefield again or place them into reserves.


This ability may only be taken by one model in your army, and cannot be taken alongside other Exemplar traits.</characteristic>
      </characteristics>
    </profile>
    <profile name="Tanglefoot Grenades" typeId="456a-26d9-cb27-bd5c" typeName="Wargear" hidden="false" id="e59a-b1c3-e9d5-8bc4">
      <characteristics>
        <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">At the beginning of the assault phase, any unit equipped with Tanglefoot Grenades may select one enemy unit within 12&quot; of it. Roll a dice. The result of the dice roll is then subtracted from the move distance of the targeted enemy unit during this assault.</characteristic>
      </characteristics>
    </profile>
    <profile name="Ballistus Grenade Launcher" typeId="8e6f-7553-28c5-95a0" typeName="Weapons" hidden="false" id="bc08-5efb-be13-7880">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">12&quot;</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">4</characteristic>
        <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">6</characteristic>
        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Assault 1, Blast</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c"/>
      </characteristics>
    </profile>
    <profile name="Adrastus Bolt Caliver (Disintegrator)" typeId="8e6f-7553-28c5-95a0" typeName="Weapons" hidden="false" id="e8d8-e064-3036-3b8e">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">18</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">8</characteristic>
        <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">3</characteristic>
        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Assault 1, Combi</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c"/>
      </characteristics>
    </profile>
    <profile name="Martial Ka&apos;tah" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="66a4-eb78-7ea4-8b78">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">At the start of your turn, select one Adeptus Custodes unit within 12&quot; of this model and one of the following Ka&apos;tah Stances. The selected unit gains the abilities of that Stance until the start of your next turn:
- Calistus Stance
- Dacatarai Stance
- Kaptaris Stance
- Rendax Stance.



A unit may only benefit from the effects of one Ka&apos;tah Stance at a time, and may never have more than one issued to it in one turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="Rendax Stance" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="aebd-d2bd-033b-3df6">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">All melee attacks made by this model gain the Rending special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Dacatarai Stance" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="2c87-2586-3e88-d175">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">This model increases its Attacks by 2, but decreases its Strength by 1.</characteristic>
      </characteristics>
    </profile>
    <profile name="Kaptaris Stance" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="b0ce-8950-e050-041d">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">This model adds 2 to its Initiative and gains the Counter-Attack special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Calistus Stance" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="45f5-8a8c-4ccb-e5e6">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">This model gains the Hit and Run and Move Through Cover special rules.</characteristic>
      </characteristics>
    </profile>
