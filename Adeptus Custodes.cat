    <profile name="Eternity Blade" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons" hidden="false" id="8b6c-3eee-fac7-b576">
      <characteristics>
        <characteristic name="Ability" typeId="2113-98a2-4376-a94c">An Eternity Blade is a master-crafted power weapon. Additionally, any failed attempts To Wound made with it may be re-rolled.</characteristic>
      </characteristics>
    </profile>
    <profile name="Blade Champion" typeId="0967-823d-dd82-4e47" typeName="Unit" hidden="false" id="1be4-7aaf-198d-2a56">
      <characteristics>
        <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">7</characteristic>
        <characteristic name="BS" typeId="63a5-4be2-9cc0-7723">5</characteristic>
        <characteristic name="S" typeId="09af-e927-0c3c-9d88">5</characteristic>
        <characteristic name="T" typeId="ff29-f8b2-5b20-b686">5</characteristic>
        <characteristic name="W" typeId="4a81-ac45-a71c-c71e">3</characteristic>
        <characteristic name="I" typeId="8517-a46c-d6df-9c75">5</characteristic>
        <characteristic name="A" typeId="a535-0722-3bc1-4d3c">4</characteristic>
        <characteristic name="Ld" typeId="ddd5-77eb-4cc8-9eab">10</characteristic>
        <characteristic name="Sv" typeId="c1e7-f1bd-8acd-7595">2+ (4++)</characteristic>
      </characteristics>
    </profile>
    <profile name="Impregnable Mind" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="1b89-e216-528b-ebc2">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">When an opposing Psyker uses a psychic power, this model may attempt to nullify it. Declare that you&apos;ll use this ability after an enemy model within 18&quot; of this model passes a Psychic test.

Each player then rolls a D6 and adds their model&apos;s leadership value to the score. If the Adeptus Custodes player&apos;s score beats the opposing model&apos;s score, the psychic power is nullified and does not take effect that turn. If the opposing model&apos;s score is equal or higher, it can use its psychic power as normal. 

Only one can attempt to nullify a psychic power with this rule may be made each turn.


This ability may only be taken by one model in your army, and cannot be taken alongside other Exemplar traits.</characteristic>
      </characteristics>
    </profile>
    <profile name="Adamantite Terminator Armor" typeId="456a-26d9-cb27-bd5c" typeName="Wargear" hidden="false" id="0650-4bd3-48ee-0764">
      <characteristics>
        <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">Adamantite Terminator Armor confers a 2+ Armour Save and a 4+ Invulnerable Save to the bearer.</characteristic>
      </characteristics>
    </profile>
    <profile name="Allarus Custodian" typeId="0967-823d-dd82-4e47" typeName="Unit" hidden="false" id="0ab3-29a0-cb26-a8e0">
      <characteristics>
        <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">5</characteristic>
        <characteristic name="BS" typeId="63a5-4be2-9cc0-7723">5</characteristic>
        <characteristic name="S" typeId="09af-e927-0c3c-9d88">5</characteristic>
        <characteristic name="T" typeId="ff29-f8b2-5b20-b686">6</characteristic>
        <characteristic name="W" typeId="4a81-ac45-a71c-c71e">3</characteristic>
        <characteristic name="I" typeId="8517-a46c-d6df-9c75">5</characteristic>
        <characteristic name="A" typeId="a535-0722-3bc1-4d3c">2</characteristic>
        <characteristic name="Ld" typeId="ddd5-77eb-4cc8-9eab">10</characteristic>
        <characteristic name="Sv" typeId="c1e7-f1bd-8acd-7595">2+ (4++)</characteristic>
      </characteristics>
    </profile>
    <profile name="Unleash the Lions" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="92c4-925a-34d9-43fa">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">At the beginning of the Adeptus Custodes player&apos;s movement phase, that player may choose to split this unit into separate units consisting of one individual model per unit. These new units are then treated as separate units for the rest of the game.


If an Independent Character is attached to this unit, it too automatically becomes unattached and treated as its own separate unit.</characteristic>
      </characteristics>
    </profile>
    <profile name="Salvo Launcher" typeId="8e6f-7553-28c5-95a0" typeName="Weapons" hidden="false" id="9861-87c9-d5fa-d184">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">24&quot;</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">8</characteristic>
        <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">1</characteristic>
        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Heavy 1, Melta</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c"/>
      </characteristics>
    </profile>
    <profile name="Interceptor Lance" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons" hidden="false" id="f4fc-af3f-b284-9e37">
      <characteristics>
        <characteristic name="Ability" typeId="2113-98a2-4376-a94c">An Interceptor Lance is a rending weapon and a power weapon that adds +2 to the wielder&apos;s Strength.

If the wielder successfully assaulted this phase, you may re-roll failed attempts To Wound for this weapon&apos;s attacks.</characteristic>
      </characteristics>
    </profile>
    <profile name="Vertus Praetor" typeId="0967-823d-dd82-4e47" typeName="Unit" hidden="false" id="08ec-4e42-9132-61e7">
      <characteristics>
        <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">5</characteristic>
