        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c"/>
      </characteristics>
    </profile>
    <profile name="Sister of Silence" id="9d5e-ebe3-4d2e-f4ca" hidden="false" typeId="0967-823d-dd82-4e47" typeName="Unit">
      <characteristics>
        <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">4</characteristic>
        <characteristic name="BS" typeId="63a5-4be2-9cc0-7723">4</characteristic>
        <characteristic name="S" typeId="09af-e927-0c3c-9d88">3</characteristic>
        <characteristic name="T" typeId="ff29-f8b2-5b20-b686">3</characteristic>
        <characteristic name="W" typeId="4a81-ac45-a71c-c71e">1</characteristic>
        <characteristic name="I" typeId="8517-a46c-d6df-9c75">4</characteristic>
        <characteristic name="A" typeId="a535-0722-3bc1-4d3c">1</characteristic>
        <characteristic name="Ld" typeId="ddd5-77eb-4cc8-9eab">9</characteristic>
        <characteristic name="Sv" typeId="c1e7-f1bd-8acd-7595">3+</characteristic>
      </characteristics>
    </profile>
    <profile name="Null" id="4500-78e5-94fd-8326" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Enemy models within 12&quot; of a Sister of Silence suffer -1 to their Leadership when resolving Psychic tests. This is increased to -2 Leadership if they are within engagement range.</characteristic>
      </characteristics>
    </profile>
    <profile name="Psyk-out Grenades" id="8674-9295-cd0d-00c6" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
      <characteristics>
        <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">When a unit equipped with Psyk-out Grenades launches an Assault, any Daemons or Psykers in the assaulted unit(s) are reduced to Initiative 1 for the remainder of the phase.</characteristic>
      </characteristics>
    </profile>
    <profile name="Witchbane" id="aced-fb03-c0ac-7087" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">During an assault, all attacks made by this model against targets that have psychic powers will always wound on a 2+.</characteristic>
      </characteristics>
    </profile>
