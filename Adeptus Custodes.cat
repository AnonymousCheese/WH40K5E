    <profile name="Guardian Spear" id="2346-74e5-e85d-610b" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
      <characteristics>
        <characteristic name="Ability" typeId="2113-98a2-4376-a94c">A Guardian Spear is a power weapon that adds +1 to the wielder&apos;s Strength. 
Any model equipped with a Guardian Spear is also equipped with an Auric Bolter.</characteristic>
      </characteristics>
    </profile>
    <profile name="Auramite Armor" id="9406-f42c-ca79-e645" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
      <characteristics>
        <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">Auramite Armor confers a 2+ Armour Save and a 5+ Invulnerable Save to the bearer.</characteristic>
      </characteristics>
    </profile>
    <profile name="Arcane Genetic Alchemy" id="8bb9-100c-aeb3-a550" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If a model with this special rule would suffer an unsaved wound, roll a dice. On a 5 or 6, that injury is ignored and no wounds are lost. 

(This does not stack with the Feel No Pain rule. However, it can be used in place of the Feel No Pain rule against any wounds for which a saving throw was not allowed, or would otherwise inflict instant death.)</characteristic>
      </characteristics>
    </profile>
    <profile name="Castellan Axe" id="e58c-f2b8-cf47-4077" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
      <characteristics>
        <characteristic name="Ability" typeId="2113-98a2-4376-a94c">A Castellan Axe is treated as a chain fist, except that it attacks at the bearer&apos;s Initiative minus 2, as opposed to at Initiative 1.
Any model equipped with a Castellan Axe is also equipped with an Auric Bolter.</characteristic>
      </characteristics>
    </profile>
    <profile name="Auric Bolt Pistol" id="0b8e-ba23-a9a8-fddd" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">12&quot;</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">4</characteristic>
        <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">5</characteristic>
        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Pistol</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c"/>
      </characteristics>
    </profile>
    <profile name="Sentinel Blade" id="3227-6e7d-0382-d488" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
      <characteristics>
        <characteristic name="Ability" typeId="2113-98a2-4376-a94c">A Sentinel Blade is treated as a power weapon. 
Any model equipped with a Sentinel Blade is also equipped with an Auric Bolt Pistol.</characteristic>
      </characteristics>
    </profile>
    <profile name="Superior Creation" id="7d83-e7cd-b7cd-7d83" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If an Adeptus Custodes model with this special rule would be removed from play after sustaining lethal damage, roll a dice. On a 1, the model is removed from play as normal. On any other result, do not remove the model from play. Instead, its remaining wounds are set to half its starting wounds and it loses the Superior Creation special rule.


This ability may only be taken by one model in your army, and cannot be taken alongside other Exemplar traits.</characteristic>
      </characteristics>
    </profile>
    <profile name="Radiant Mantle" id="d7e0-b2dc-e254-d131" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Shooting attacks that target this model subtract 1 from their BS when rolling to hit.


This ability may only be taken by one model in your army, and cannot be taken alongside other Exemplar traits.</characteristic>
      </characteristics>
    </profile>
    <profile name="Custodian Guard" id="740a-8547-a7b8-ef74" hidden="false" typeId="0967-823d-dd82-4e47" typeName="Unit">
      <characteristics>
        <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">5</characteristic>
        <characteristic name="BS" typeId="63a5-4be2-9cc0-7723">5</characteristic>
        <characteristic name="S" typeId="09af-e927-0c3c-9d88">5</characteristic>
        <characteristic name="T" typeId="ff29-f8b2-5b20-b686">5</characteristic>
        <characteristic name="W" typeId="4a81-ac45-a71c-c71e">2</characteristic>
        <characteristic name="I" typeId="8517-a46c-d6df-9c75">5</characteristic>
        <characteristic name="A" typeId="a535-0722-3bc1-4d3c">2</characteristic>
        <characteristic name="Ld" typeId="ddd5-77eb-4cc8-9eab">10</characteristic>
        <characteristic name="Sv" typeId="c1e7-f1bd-8acd-7595">2+ (5++)</characteristic>
      </characteristics>
    </profile>
    <profile name="Golden Fortitude" id="c5e9-ede3-9a5f-3a3a" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Models with the Golden Fortitude special rule have a 4+ invulnerable save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Vexilla" id="635c-7a38-1032-4e90" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
      <characteristics>
        <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">A model with a Vexilla reduces the Ld of enemy units within 12&quot; by 1.</characteristic>
      </characteristics>
    </profile>
    <profile name="Adrastus Bolt Caliver (Bolter)" id="7a96-4648-7dc0-d0fe" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">36</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">4</characteristic>
        <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">4</characteristic>
        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">2 x Rapid Fire</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c"/>
      </characteristics>
    </profile>
    <profile name="Arae Shrike" id="cd7d-56f3-0dbd-4e8e" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
      <characteristics>
        <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">A model equipped with an Arae Shrike gains the Deep Strike special rule, and confers it to any unit that it joins. 


Additionally, while this model is on the battlefield, any time a enemy unit is set up via Deep Strike within 12&quot; of this model, you may choose to have that unit&apos;s controller reroll the scatter dice and/or the 2D6 roll to determine how far the unit scatters.</characteristic>
      </characteristics>
    </profile>
    <profile name="Misericordia" id="1508-6096-5ba2-6ee3" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
      <characteristics>
        <characteristic name="Ability" typeId="2113-98a2-4376-a94c">A unit equipped with a Misericordia may make one additional attack during an assault if it is not also equipped with a storm shield. This attack is resolved at Initiative 0, and causes Instant Death if not saved.</characteristic>
      </characteristics>
    </profile>
    <profile name="Custodian Warden" id="e855-654a-8260-e71d" hidden="false" typeId="0967-823d-dd82-4e47" typeName="Unit">
      <characteristics>
        <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">5</characteristic>
        <characteristic name="BS" typeId="63a5-4be2-9cc0-7723">5</characteristic>
        <characteristic name="S" typeId="09af-e927-0c3c-9d88">5</characteristic>
        <characteristic name="T" typeId="ff29-f8b2-5b20-b686">5</characteristic>
        <characteristic name="W" typeId="4a81-ac45-a71c-c71e">2</characteristic>
        <characteristic name="I" typeId="8517-a46c-d6df-9c75">5</characteristic>
        <characteristic name="A" typeId="a535-0722-3bc1-4d3c">2</characteristic>
        <characteristic name="Ld" typeId="ddd5-77eb-4cc8-9eab">10</characteristic>
        <characteristic name="Sv" typeId="c1e7-f1bd-8acd-7595">2+ (5++)</characteristic>
      </characteristics>
    </profile>
    <profile name="Eternity Blade" id="8b6c-3eee-fac7-b576" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
      <characteristics>
        <characteristic name="Ability" typeId="2113-98a2-4376-a94c">An Eternity Blade is a master-crafted power weapon. Additionally, any failed attempts To Wound made with it may be re-rolled.</characteristic>
      </characteristics>
    </profile>
    <profile name="Blade Champion" id="1be4-7aaf-198d-2a56" hidden="false" typeId="0967-823d-dd82-4e47" typeName="Unit">
      <characteristics>
        <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">7</characteristic>
        <characteristic name="BS" typeId="63a5-4be2-9cc0-7723">5</characteristic>
        <characteristic name="S" typeId="09af-e927-0c3c-9d88">5</characteristic>
        <characteristic name="T" typeId="ff29-f8b2-5b20-b686">5</characteristic>
        <characteristic name="W" typeId="4a81-ac45-a71c-c71e">3</characteristic>
        <characteristic name="I" typeId="8517-a46c-d6df-9c75">5</characteristic>
        <characteristic name="A" typeId="a535-0722-3bc1-4d3c">4</characteristic>
        <characteristic name="Ld" typeId="ddd5-77eb-4cc8-9eab">10</characteristic>
        <characteristic name="Sv" typeId="c1e7-f1bd-8acd-7595">2+ (4++)</characteristic>
      </characteristics>
    </profile>
    <profile name="Impregnable Mind" id="1b89-e216-528b-ebc2" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">When an opposing Psyker uses a psychic power, this model may attempt to nullify it. Declare that you&apos;ll use this ability after an enemy model within 18&quot; of this model passes a Psychic test.

Each player then rolls a D6 and adds their model&apos;s leadership value to the score. If the Adeptus Custodes player&apos;s score beats the opposing model&apos;s score, the psychic power is nullified and does not take effect that turn. If the opposing model&apos;s score is equal or higher, it can use its psychic power as normal. 

Only one can attempt to nullify a psychic power with this rule may be made each turn.


This ability may only be taken by one model in your army, and cannot be taken alongside other Exemplar traits.</characteristic>
      </characteristics>
    </profile>
    <profile name="Adamantite Terminator Armor" id="0650-4bd3-48ee-0764" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
      <characteristics>
        <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">Adamantite Terminator Armor confers a 2+ Armour Save and a 4+ Invulnerable Save to the bearer.</characteristic>
      </characteristics>
    </profile>
    <profile name="Allarus Custodian" id="0ab3-29a0-cb26-a8e0" hidden="false" typeId="0967-823d-dd82-4e47" typeName="Unit">
      <characteristics>
        <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">5</characteristic>
        <characteristic name="BS" typeId="63a5-4be2-9cc0-7723">5</characteristic>
        <characteristic name="S" typeId="09af-e927-0c3c-9d88">5</characteristic>
        <characteristic name="T" typeId="ff29-f8b2-5b20-b686">6</characteristic>
        <characteristic name="W" typeId="4a81-ac45-a71c-c71e">3</characteristic>
        <characteristic name="I" typeId="8517-a46c-d6df-9c75">5</characteristic>
        <characteristic name="A" typeId="a535-0722-3bc1-4d3c">2</characteristic>
        <characteristic name="Ld" typeId="ddd5-77eb-4cc8-9eab">10</characteristic>
        <characteristic name="Sv" typeId="c1e7-f1bd-8acd-7595">2+ (4++)</characteristic>
      </characteristics>
    </profile>
    <profile name="Unleash the Lions" id="92c4-925a-34d9-43fa" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">At the beginning of the Adeptus Custodes player&apos;s movement phase, that player may choose to split this unit into separate units consisting of one individual model per unit. These new units are then treated as separate units for the rest of the game.


If an Independent Character is attached to this unit, it too automatically becomes unattached and treated as its own separate unit.</characteristic>
      </characteristics>
    </profile>
    <profile name="Salvo Launcher" id="9861-87c9-d5fa-d184" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">24&quot;</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">8</characteristic>
        <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">1</characteristic>
        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Heavy 1, Melta</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c"/>
      </characteristics>
    </profile>
    <profile name="Interceptor Lance" id="f4fc-af3f-b284-9e37" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
      <characteristics>
        <characteristic name="Ability" typeId="2113-98a2-4376-a94c">An Interceptor Lance is a rending weapon and a power weapon that adds +2 to the wielder&apos;s Strength.

If the wielder successfully assaulted this phase, you may re-roll failed attempts To Wound for this weapon&apos;s attacks.</characteristic>
      </characteristics>
    </profile>
    <profile name="Vertus Praetor" id="08ec-4e42-9132-61e7" hidden="false" typeId="0967-823d-dd82-4e47" typeName="Unit">
      <characteristics>
        <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">5</characteristic>
        <characteristic name="BS" typeId="63a5-4be2-9cc0-7723">5</characteristic>
        <characteristic name="S" typeId="09af-e927-0c3c-9d88">5</characteristic>
        <characteristic name="T" typeId="ff29-f8b2-5b20-b686">5(6)</characteristic>
        <characteristic name="W" typeId="4a81-ac45-a71c-c71e">3</characteristic>
        <characteristic name="I" typeId="8517-a46c-d6df-9c75">6</characteristic>
        <characteristic name="A" typeId="a535-0722-3bc1-4d3c">2</characteristic>
        <characteristic name="Ld" typeId="ddd5-77eb-4cc8-9eab">10</characteristic>
        <characteristic name="Sv" typeId="c1e7-f1bd-8acd-7595">2+ (5++)</characteristic>
      </characteristics>
    </profile>
    <profile name="Pyrithite Spear" id="3c0c-ee99-f1c7-2073" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
      <characteristics>
        <characteristic name="Ability" typeId="2113-98a2-4376-a94c">A Pyrithite Spear is a power weapon that adds +2 to the wielder&apos;s Strength. 
Any model equipped with a Pyrithite Spear is also equipped with a Meltagun.</characteristic>
      </characteristics>
    </profile>
    <profile name="Castellan&apos;s Mark" id="f329-080c-bd9a-0d8c" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If this model is on the battlefield at the start of the game before the first turn begins, you may select up to two of your Adeptus Custodes units on the battlefield including the bearer and its unit. You may then set them up on the battlefield again or place them into reserves.


This ability may only be taken by one model in your army, and cannot be taken alongside other Exemplar traits.</characteristic>
      </characteristics>
    </profile>
    <profile name="Tanglefoot Grenades" id="e59a-b1c3-e9d5-8bc4" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
      <characteristics>
        <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">At the beginning of the assault phase, any unit equipped with Tanglefoot Grenades may select one enemy unit within 12&quot; of it. Roll a dice. The result of the dice roll is then subtracted from the move distance of the targeted enemy unit during this assault.</characteristic>
      </characteristics>
    </profile>
    <profile name="Ballistus Grenade Launcher" id="bc08-5efb-be13-7880" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">12&quot;</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">4</characteristic>
        <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">6</characteristic>
        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Assault 1, Blast</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c"/>
      </characteristics>
    </profile>
    <profile name="Adrastus Bolt Caliver (Disintegrator)" id="e8d8-e064-3036-3b8e" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">18</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">8</characteristic>
        <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">3</characteristic>
        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Assault 1, Combi</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c"/>
      </characteristics>
    </profile>
    <profile name="Martial Ka&apos;tah" id="66a4-eb78-7ea4-8b78" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">At the start of your turn, select one Adeptus Custodes unit within 12&quot; of this model and one of the following Ka&apos;tah Stances. The selected unit gains the abilities of that Stance until the start of your next turn:
- Calistus Stance
- Dacatarai Stance
- Kaptaris Stance
- Rendax Stance.



A unit may only benefit from the effects of one Ka&apos;tah Stance at a time, and may never have more than one issued to it in one turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="Rendax Stance" id="aebd-d2bd-033b-3df6" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">All melee attacks made by this model gain the Rending special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Dacatarai Stance" id="2c87-2586-3e88-d175" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">This model increases its Attacks by 2, but decreases its Strength by 1.</characteristic>
      </characteristics>
    </profile>
    <profile name="Kaptaris Stance" id="b0ce-8950-e050-041d" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">This model adds 2 to its Initiative and gains the Counter-Attack special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Calistus Stance" id="45f5-8a8c-4ccb-e5e6" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">This model gains the Hit and Run and Move Through Cover special rules.</characteristic>
      </characteristics>
    </profile>
    <profile name="Venatari Custodian" id="5ec8-43e5-46dc-97f1" hidden="false" typeId="0967-823d-dd82-4e47" typeName="Unit">
      <characteristics>
        <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">5</characteristic>
        <characteristic name="BS" typeId="63a5-4be2-9cc0-7723">5</characteristic>
        <characteristic name="S" typeId="09af-e927-0c3c-9d88">5</characteristic>
