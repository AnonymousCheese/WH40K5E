    <profile name="Master-Crafted Weapon" id="62a6-124a-b53a-d335" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
      <characteristics>
        <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">The bearer may choose one of their weapons to become Master-crafted. A Master-crafted weapon follows the normal rules for the weapon, except you may re-roll one failed to hit roll per turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="Apothecary" id="f37f-7fb9-6464-3cbf" hidden="false" typeId="0967-823d-dd82-4e47" typeName="Unit">
      <characteristics>
        <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">4</characteristic>
