      <profiles>
        <profile name="Unmatched Zeal" id="f98c-c599-bad5-2f0c" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">This model and any unit they&apos;re attached to are Fearless. In addition, any Righteous Zeal moves may be made towards any enemy unit, not just the nearest one as would normally be the case.</characteristic>
          </characteristics>
        </profile>
        <profile name="Litanies of Hate" id="48f6-18f4-1538-ff80" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">On a player turn in which he charges into close combat, a Chaplain, and all members of any Black Templars Space Marine squad he has joined, leads or is attached to, may re-roll failed rolls to hit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
