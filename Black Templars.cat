        <profile name="Sword of the High Marshal" id="1421-1240-f9d8-3431" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
          <characteristics>
            <characteristic name="Ability" typeId="2113-98a2-4376-a94c">This is a Master-crafted power weapon. In the first round of any assault, Helbrecht gains +D3 Attacks in addition to any other bonuses.</characteristic>
          </characteristics>
        </profile>
        <profile name="Rites of Battle" id="5509-d1bc-1955-f3f5" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">While this model is on the table, all other Black Templar units may use his Leadership for Morale, Pinning or Leadership tests.</characteristic>
          </characteristics>
        </profile>
