        <profile name="Independent Operators" id="61df-dbd8-c601-e871" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">1-3 Death-Cult Assassins may be chosen as a single Elites choice. They are deployed as a single choice but do not need to be placed together and operate independently during the game.


Death-cult assassins may not join units or ride in vehicles. This unit can never be a scoring unit.</characteristic>
          </characteristics>
        </profile>
