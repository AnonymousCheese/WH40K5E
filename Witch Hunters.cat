    <profile name="Electro-flails" id="066e-9e80-3f55-5714" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
      <characteristics>
        <characteristic name="Ability" typeId="2113-98a2-4376-a94c">These count as power weapons. Arvo-flagellants do not receive a bonus for being armed with an additional close combat weapon</characteristic>
      </characteristics>
