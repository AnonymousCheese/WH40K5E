        <profile name="Cold Steel and Courage" id="521e-7542-6c87-ed06" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Friendly units within 12&quot; of Straken have the Counter-attack and Furious Charge universal special rules. This includes Colonel Straken and his Command Squad.</characteristic>
          </characteristics>
        </profile>
        <profile name="Man of Adamantium" id="1593-4723-73be-4f03" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Straken&apos;s close combat attacks ignore armour saves and roll and additional D6 for armour penetration.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
