        <profile name="Claw of the Desert Tigers" id="e6b3-f798-f04d-3c3a" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">The Claw of the Desert Tigers is a power weapon that inflicts instant death, regardless of the victim&apos;s Toughness.</characteristic>
          </characteristics>
        </profile>
