        <profile name="Gung-ho" id="b3e8-6af1-b293-da07" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Colonel Straken has the Fearless universal special rule, as does his Command Squad</characteristic>
