        <profile name="Cyber-steed" id="49c9-9098-72a4-5745" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">On a turn that Mogul Kamir charges he receives +D3 Attacks instead of +1</characteristic>
          </characteristics>
        </profile>
        <profile name="Khanasan&apos;s Fiercest" id="ab7e-7efc-9439-d09a" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Mogul Kamir and his unit of Rough Riders have the Furious Charge ability. Whilst Mogul Kamir is alive, he and his unit are Fearless</characteristic>
          </characteristics>
        </profile>
        <profile name="Vicious Temperament" id="71da-bc5e-ba4b-e78c" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">As long as Mogul Kamir is alove, he and his unit are subject to the Rage special rule</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Unique Sergeant" id="47ba-c6fe-d2bd-03ce" hidden="false">
          <description>One Rough Rider squad in your army may replace its Rough Rider Sergeant with Mogul Kamir</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Knight Commander Pask" id="3d50-1727-a3b7-b711" hidden="false" import="true" type="unit">
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="50"/>
      </costs>
      <profiles>
        <profile name="Leman Russ Tank Ace" id="85f0-284c-9f2e-cfb9" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Pask&apos;s Leman Russ can use his Ballistic Skill of 4. 


If the Leman Russ suffers a vehicle destroyed result, then Pask is slain.</characteristic>
          </characteristics>
        </profile>
        <profile name="Crack Shot" id="666c-a94d-215b-df7e" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Provided Pask&apos;s Leman Russ remained stationary during the Movement Phase, all shots made by Pask&apos;s Leman Russ that turn benefit from the Crack Shot rule.


If using the Crack Shot rule when firing against a vehicle, all shots add +1 to any armour penetration rolls.


If using the Crack Shot rule when firing at a monstrous creature, any hits that failed to Wound may be re-rolled.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Unique Tank Commander" id="622d-bbc2-c2e5-0f2d" hidden="false">
          <description>A single model in a Leman Russ squadron may take Knight Commander Pask as an upgrade.</description>
        </rule>
      </rules>
    </selectionEntry>
