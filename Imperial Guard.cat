    <profile name="Carapace Armour" id="39a4-9761-14b0-f80f" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
      <characteristics>
        <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">A model equipped with carapace armour has a 4+ armour save</characteristic>
      </characteristics>
    </profile>
    <profile name="Snare mines" id="425f-398e-f50c-8a46" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
      <characteristics>
        <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">A squad armed with snare mines is counted as having defensive grenades</characteristic>
      </characteristics>
    </profile>
    <profile name="Ripper Pistol" id="7aa8-0745-30eb-7d6c" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
      <characteristics>
