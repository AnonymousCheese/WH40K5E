  <sharedRules>
    <rule name="Reconnaissance" id="4572-3720-10ae-12f5" hidden="false">
      <description>The reconnaissance mission grants the Scouts and Move Through Cover special rules</description>
    </rule>
    <rule name="Airborne Assault" id="6244-8629-df8e-2b3d" hidden="false">
      <description>The airborne assault mission allows the Storm Trooper squad to re-roll the scatter dice when they deep strike.</description>
    </rule>
    <rule name="Behind Enemy Lines" id="bad3-cdf9-b489-99eb" hidden="false">
      <description>The behind enemy lines mission grants the squad infiltrate special rule and their weapons count as Pinning the first time the squad fires.</description>
    </rule>
    <rule name="Look Out - Arghh!" id="c50b-ca51-2909-c0d7" hidden="false">
      <description>Whilst a Bodyguard is alive, each time the Command Squad is wounded by the enemy, up to two wounds allocated to the Company Commander are instead resolved against the Bodyguard(s).</description>
    </rule>
    <rule name="Unique Senior Officer" id="e3eb-5eda-1ba9-14d6" hidden="false">
      <description>One Company Command Squad in your army may replace it&apos;s Company Commander with this model</description>
    </rule>
    <rule name="Unique Junior Officer" id="8df4-090c-0bf9-8aae" hidden="false">
      <description>One Platoon Command Squad in your army may replace its Platoon Commander with this model.</description>
    </rule>
  </sharedRules>
  <sharedSelectionEntries>
