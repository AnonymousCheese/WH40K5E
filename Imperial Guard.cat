        <profile name="Two hot-shot laspistols" id="c4d4-5569-3a9b-3c8d" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
          <characteristics>
            <characteristic name="Range" typeId="9b9e-0c24-e409-a801">6&quot;</characteristic>
            <characteristic name="Str." typeId="1ebc-896c-43de-904a">3</characteristic>
            <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">3</characteristic>
            <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Pistol, Twin-linked</characteristic>
            <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c"/>
          </characteristics>
        </profile>
        <profile name="Supreme Commander" id="9120-419e-7270-b3f2" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Creed can issue up to four orders each turn. He has a command radius of 24&quot;. Creed can use &apos;For the Honour of Cadia!&apos;, &apos;Bring it Down!&apos;, &apos;Fire on my Target!&apos;, &apos;Get Back in the Fight!&apos;, &apos;First Rank, FIRE! Second Rank, FIRE!&apos;, &apos;Incoming!&apos; and &apos;Move! Move! Move!&apos;</characteristic>
          </characteristics>
        </profile>
        <profile name="Tactical Genius" id="5198-2eea-288d-b2ba" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">During deployment, choose a single infantry or vehicle unit in your army. That unit has the Scouts special rule for the duration of the battle.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Colour Sergeant Kell" id="eeb1-7fa9-0c9d-152a" hidden="false" import="true" type="unit">
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="85"/>
      </costs>
      <infoLinks>
        <infoLink name="Laspistol" id="e429-1448-bd42-d6ec" hidden="false" targetId="e061-dada-0483-3fff" type="profile"/>
        <infoLink name="Power Weapon" id="282d-bafa-a50d-5428" hidden="false" targetId="31dd-6647-d267-e3c2" type="profile"/>
        <infoLink name="Power Fist" id="eaff-c429-1dea-ced9" hidden="false" targetId="cc61-3ec6-0369-8cd8" type="profile"/>
        <infoLink name="Frag Grenades" id="10e4-5ef3-cdd6-7564" hidden="false" targetId="6e7c-a63e-3bc6-5bc9" type="profile"/>
