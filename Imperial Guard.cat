                <profile name="Telepathic Relay" id="0601-1845-28d1-3696" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Whilst the Astropath is alive, you add 1 to any of your reserve rolls. In addition, if any of your units arrive using the outflank rule, you can re-roll the dice used to determine which board edge these squads arrives from.</characteristic>
