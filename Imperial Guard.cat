      </entryLinks>
      <infoLinks>
        <infoLink name="Tank" id="a417-d43e-4e80-60ed" hidden="false" targetId="3475-46b4-28e6-8fb0" type="rule"/>
        <infoLink name="Searchlight" id="745f-6dcf-ee70-3e99" hidden="false" targetId="589c-c16c-2ed7-61f9" type="profile"/>
