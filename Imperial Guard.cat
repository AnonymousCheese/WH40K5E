        <profile name="Desert Raider" id="4ffc-2899-1482-e18e" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Al&apos;rahem can issue up to two orders each turn. He has a command radius of 12&quot;. Al&apos;rahem can use the Bring it Down!, First Rank, FIRE! Second Rank, FIRE! and Like the Wind! orders.</characteristic>
          </characteristics>
