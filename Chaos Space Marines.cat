    <selectionEntry name="Daemon Weapon" id="47cc-6cf7-39d2-838e" hidden="false" import="true" type="unit">
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="40"/>
      </costs>
      <profiles>
        <profile name="Daemon Weapon" id="48e5-534b-9a37-3469" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
          <characteristics>
            <characteristic name="Ability" typeId="2113-98a2-4376-a94c">This is a power weapon which requires two hands to use. It adds an additional D6 attacks in close combat. Roll the dice every time the model is about to attack. On a roll of 1, the model may not make any attacks in this round and suffers one wound with no armour saves allowed.


Daemon Weapons have an additional ability based on which Mark of Chaos they have.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntryGroups>
        <selectionEntryGroup name="Additional Ability (pick based on equipped Mark of Chaos)" id="a540-cd5d-1275-0502" defaultSelectionEntryId="4286-d25a-d6b0-a164" hidden="false">
          <constraints>
            <constraint id="63e9-5500-f33d-53ad-min" field="selections" scope="self" shared="true" type="min" value="1"/>
            <constraint id="63e9-5500-f33d-53ad-max" field="selections" scope="self" shared="true" type="max" value="1"/>
          </constraints>
          <selectionEntries>
            <selectionEntry name="Daemon Weapon (No Mark of Chaos)" id="4286-d25a-d6b0-a164" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="f483-84a1-7ae9-8b26" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Daemon Weapon (No Mark of Chaos)" id="534d-ccd3-5666-ac61" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="e24a-6018-20cf-d76c"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Bloodfeeder (Mark of Khorne)" id="fc41-fcab-d622-cb2e" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="a1ab-df9f-faea-4813" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Bloodfeeder (Mark of Khorne)" id="e8ca-75e2-d014-1e66" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="e24a-6018-20cf-d76c">A model with Bloodfeeder gains 2D6 attacks rather than D6. If either dice rolls a 1, the model does not attack and suffers one wound (not one wound for each 1 rolled)</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Plaguebringer (Mark of Nurgle)" id="3eaf-808b-a4b5-86cb" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="c093-3c16-0cca-0d9d" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Plaguebringer (Mark of Nurgle)" id="1f55-11ee-e51d-1e0b" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="e24a-6018-20cf-d76c">A model with Plaguebringer has Poisoned (4+) in close combat.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Deathscreamer (Mark of Tzeentch)" id="84bd-de7e-a54e-9c75" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="da0f-e6ab-45c0-b71e" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Deathscreamer (Mark of Tzeentch)" id="80f6-c729-5600-9cdb" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
                  <characteristics>
                    <characteristic name="Range" typeId="9b9e-0c24-e409-a801">24&quot;</characteristic>
                    <characteristic name="Str." typeId="1ebc-896c-43de-904a">4</characteristic>
                    <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">3</characteristic>
                    <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Assault D6</characteristic>
                    <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c">If a 1 is rolled for number of shots, no shots are fired and the wielder suffers a wound with no armour save allowed.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Blissgiver (Mark of Slaanesh)" id="7b4e-2041-7574-bea3" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="dd8f-25a2-f634-55a1" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Blissgiver (Mark of Slaanesh)" id="3003-591a-c707-4cbf" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Any wounds caused on the enemy by Blissgiver inflict Instant Death, regardless of the target&apos;s Toughness.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
