        <profile name="Mark of Chaos Ascendant" id="a7d5-ba94-1e1a-e817" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">This model has all marks of Chaos (these are reflected in his profile) The mark of Tzeentch grants him a 4+ invulnerable save. Additionally, he is immune to Instant Death.</characteristic>
          </characteristics>
        </profile>
        <profile name="Daemon Sword Drach&apos;nyen and Talon of Horus" id="92d3-8c9f-3bb9-9cb0" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
          <characteristics>
            <characteristic name="Ability" typeId="2113-98a2-4376-a94c">This weapon counts as a Daemon Weapon which doubles his Strength (shown in profile) instead of the normal +1, and he may re-roll any failed roll to wound in combat. This models gains +D6 attacks in melee from the Daemon weapon.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
