      </infoLinks>
      <profiles>
        <profile name="Armour of Shrieking Souls" id="c068-2598-59fe-92db" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">For each successful Power armour save or Invulnerable save Lucius makes in close combat, the unit causing the wound immediately suffers a Strength 4 hit that ignored armour saves.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lash of Torment" id="6567-6b42-712e-dc19" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
          <characteristics>
            <characteristic name="Ability" typeId="2113-98a2-4376-a94c">This counts as a close combat weapon, and in addition it reduces the Attacks of any model in base contact with Lucius by 1 (to a minimum of 1).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
