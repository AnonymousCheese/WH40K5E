    <profile name="Daemonkin" id="7f92-f49d-2553-6122" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">At the beginning of each game, after deployment, roll a dice on the table below. The Possessed unit will have the special rule or extra equipment indicated in the table for the game.


1 - Scouts
2 - Furious Charge
3 - Fleet
4 - Rending
5 - Feel No Pain
6 - Power Weapon</characteristic>
      </characteristics>
