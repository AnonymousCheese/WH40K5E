          </infoLinks>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
    <selectionEntry name="Ragnar Blackmane" id="aacf-158e-50bb-42b2" hidden="false" import="true" type="unit">
      <constraints>
        <constraint id="c193-25f5-24bc-40b1" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
