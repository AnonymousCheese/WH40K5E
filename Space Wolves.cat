        <profile name="Fire Control" id="a73a-7911-4008-b3ec" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">As long as the Squad Leader is still alive and does not shoot in the Shooting phase the unit may split its fire and fire at two different targets instead of one. Simply declare which models will fire at each target and then carry on using the normal rules.</characteristic>
