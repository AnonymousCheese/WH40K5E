    <selectionEntry name="Bjorn the Fell-Handed" id="0e9d-f9cd-38b9-e1f7" hidden="false" import="true" type="unit">
      <constraints>
        <constraint id="db26-d25d-cc6c-d656" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
