      <profiles>
        <profile name="Behind Enemy Lines" id="fb23-c7aa-cbcd-5eb9" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If a Wolf Scout unit makes use of its ability to outflank, roll a dice when it enters play to see where it may be deployed. On the roll of a 1 the Wolf Scout unit enters play from the short table edge to the owning player&apos;s left, on a 2 they enter play from the short table edge to the owning player&apos;s right, and on a 3-6 they enter play from any table edge the Space Wolves player wishes. This may even be his opponent&apos;s table edge.</characteristic>
          </characteristics>
        </profile>
      </profiles>
