        <characteristic name="Sv" typeId="c1e7-f1bd-8acd-7595">3+</characteristic>
      </characteristics>
    </profile>
    <profile name="Wolf Lord" id="076f-a711-7a7b-25e9" hidden="false" typeId="0967-823d-dd82-4e47" typeName="Unit">
      <characteristics>
