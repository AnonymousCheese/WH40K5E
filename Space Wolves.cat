      </characteristics>
    </profile>
    <profile name="Battle Leader in Terminator Armour" id="587d-ad2e-a606-fe5b" hidden="false" typeId="0967-823d-dd82-4e47" typeName="Unit">
      <characteristics>
        <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">5</characteristic>
