      <infoLinks>
        <infoLink name="Bjorn the Fell-Handed" id="8809-023d-97ba-f9a0" hidden="false" targetId="d3c5-42f2-cd4f-a839" type="profile"/>
        <infoLink name="Walker" id="4a6d-0898-6096-8538" hidden="false" targetId="fea1-2c4a-c33c-5600" type="rule"/>
        <infoLink name="Dreadnought Close Combat Weapon" id="7d9b-b9ff-5938-07bf" hidden="false" targetId="72a1-7ddd-b4ae-b945" type="profile"/>
        <infoLink name="Heavy Flamer" id="0557-20e2-db52-709a" hidden="false" targetId="f83b-3e9d-4395-7a68" type="profile"/>
        <infoLink name="Wolf Tail Talisman" id="6683-a35e-6052-2aca" hidden="false" targetId="a3a6-d8c5-66e4-56b4" type="profile"/>
        <infoLink name="Smoke Launchers" id="d2aa-87b5-fead-bc91" hidden="false" targetId="180e-ad4b-4df0-81ae" type="profile"/>
        <infoLink name="Saga of Majesty" id="0d65-d08b-e390-215f" hidden="false" targetId="fb2c-4d02-0b68-4520" type="profile"/>
      </infoLinks>
      <profiles>
        <profile name="Venerable" id="9e96-6b7a-a985-0eab" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If a Venerable Dreadnought suffers a glancing or penetrating hit, you may ask your opponent to re-roll the result rolled on the Vehicle Damage Chart. You must accept the result of the second roll, even if it is worse than the first.</characteristic>
          </characteristics>
        </profile>
        <profile name="Ancient Tactician" id="4035-8346-223c-5724" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">An army that includes Bjorn can re-roll the dice to see who picks their deployment zone first.</characteristic>
          </characteristics>
        </profile>
        <profile name="Ward of the Primarch" id="4981-6481-2921-f837" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Bjorn has a 5+ Invulnerable saving throw against any glancing or penetrating hit inflicted upon him.</characteristic>
          </characteristics>
        </profile>
        <profile name="Living Relic" id="7163-3820-7778-5a5d" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If Bjorn suffers any Destroyed result, leave the model in place. From that point on, all Space Wolves become Fearless for the rest of the game. If the mission uses objectives, Bjorn&apos;s remains are counted as an additional objective. If the mission uses kill points, the Space Wolves player forfeits an extra D3 kill points unless he has a model in contact with Bjorn at the end of the game. Such is the price of failure!</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntryGroups>
        <selectionEntryGroup name="Ranged Weapon" id="63bd-de8f-e591-04dc" defaultSelectionEntryId="5446-2410-b670-f3c8" hidden="false">
          <constraints>
