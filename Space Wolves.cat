    </profile>
    <profile name="Wolf Priest in Terminator Armour" id="3c8a-576e-71e9-5087" hidden="false" typeId="0967-823d-dd82-4e47" typeName="Unit">
      <characteristics>
        <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">5</characteristic>
        <characteristic name="BS" typeId="63a5-4be2-9cc0-7723">4</characteristic>
