              <profiles>
                <profile name="Mindlock" id="6a3e-53b2-f6d6-0e39" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Unless led by an Inquisitor, a unit containing Servitors must roll a D6 at the start of each friendly turn. If the result is a 1, 2 or 3 the unit may not move, shoot or assault that turn, though it will fight in close combat if already engaged.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
