            <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c"/>
          </characteristics>
        </profile>
        <profile name="Spy Network" id="5b90-87c3-e5fb-7210" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Coteaz allows you to re-roll the dice to Seize the Initiative, or force your opponent to re-roll his.</characteristic>
          </characteristics>
        </profile>
        <profile name="I&apos;ve Been Expecting You" id="8da4-138d-1559-f86f" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If an enemy unit arrives from reserve within 12&quot; of Coteaz and within his line of sight, Coteaz and his unit can immediately make an out-of-sequence shooting attack against it. There is no limit on how many times the ability can be used in a turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lord of Formosa" id="6d4c-5b5d-f50a-21cc" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Inquisitorial Henchmen warbands are Troop choices in an army that includes Inquisitor Coteaz, and are not limited by the number of Inquisitors in your army.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Inquisitor Karamazov" id="c799-6985-b404-9720" hidden="false" import="true" type="unit">
      <costs>
